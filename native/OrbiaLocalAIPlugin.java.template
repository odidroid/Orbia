package __PACKAGE__;

import android.os.Handler;
import android.os.Looper;

import com.getcapacitor.JSObject;
import com.getcapacitor.Plugin;
import com.getcapacitor.PluginCall;
import com.getcapacitor.PluginMethod;
import com.getcapacitor.annotation.CapacitorPlugin;

import java.io.File;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.InputStream;
import java.net.HttpURLConnection;
import java.net.URL;
import java.security.MessageDigest;
import java.util.concurrent.ExecutorService;
import java.util.concurrent.Executors;
import java.util.concurrent.atomic.AtomicBoolean;

@CapacitorPlugin(name = "OrbiaLocalAI")
public class OrbiaLocalAIPlugin extends Plugin {
    private static final String MODEL_FILE = "qwen2.5-0.5b-instruct-q4_0.gguf";
    private static final String MODEL_URL =
        "https://huggingface.co/Qwen/Qwen2.5-0.5B-Instruct-GGUF/resolve/12145bd1d629190a4d44254073650877954d02c9/qwen2.5-0.5b-instruct-q4_0.gguf?download=true";
    private static final long EXPECTED_APPROX_BYTES = 429L * 1024L * 1024L;
    private static final String EXPECTED_SHA256 = "7671c0c304e6ce5a7fc577bcb12aba01e2c155cc2efd29b2213c95b18edaf6ed";

    private final ExecutorService executor = Executors.newSingleThreadExecutor();
    private final AtomicBoolean cancelDownload = new AtomicBoolean(false);
    private volatile boolean downloading = false;
    private volatile String downloadState = "idle";
    private volatile String downloadMessage = "";
    private volatile long downloadedBytes = 0L;
    private volatile boolean modelLoaded = false;
    private volatile boolean generationInProgress = false;
    private volatile boolean modelLoading = false;
    private final Handler mainHandler = new Handler(Looper.getMainLooper());

    private static final boolean NATIVE_LIBRARY_LOADED;
    static {
        boolean loaded;
        try { System.loadLibrary("orbia_llama"); loaded = true; }
        catch (Throwable error) { loaded = false; }
        NATIVE_LIBRARY_LOADED = loaded;
    }

    private interface TokenCallback { void onToken(String token); }
    private static native String nativeLoadModel(String path, int contextSize, int threads);
    private static native String nativeGenerate(String prompt, int maxTokens, float temperature, TokenCallback callback);
    private static native void nativeStopGeneration();
    private static native void nativeUnloadModel();

    private File modelDirectory() {
        File directory = new File(getContext().getFilesDir(), "orbia-models");
        if (!directory.exists()) directory.mkdirs();
        return directory;
    }

    private File modelFile() {
        return new File(modelDirectory(), MODEL_FILE);
    }

    private File partialFile() {
        return new File(modelDirectory(), MODEL_FILE + ".part");
    }

    @PluginMethod
    public void getStatus(PluginCall call) {
        JSObject result = new JSObject();
        result.put("supported", true);
        result.put("runtimeReady", modelLoaded && NATIVE_LIBRARY_LOADED);
        result.put("nativeRuntimeAvailable", NATIVE_LIBRARY_LOADED);
        result.put("modelLoading", modelLoading);
        result.put("generationInProgress", generationInProgress);
        result.put("modelInstalled", modelFile().isFile() && modelFile().length() > 0);
        result.put("downloading", downloading);
        result.put("downloadState", downloadState);
        result.put("downloadMessage", downloadMessage);
        result.put("downloadedBytes", downloadedBytes);
        result.put("mode", modelLoaded ? "local-inference-ready" : (NATIVE_LIBRARY_LOADED ? "runtime-ready-model-not-loaded" : "native-runtime-unavailable"));
        result.put("message", modelLoaded ? "IA local carregada neste aparelho." : (NATIVE_LIBRARY_LOADED ? "Runtime llama.cpp instalado; carregue o modelo para conversar." : "Biblioteca llama.cpp não encontrada neste APK."));
        call.resolve(result);
    }

    @PluginMethod
    public void getModelInfo(PluginCall call) {
        JSObject result = new JSObject();
        result.put("name", "Qwen2.5-0.5B-Instruct");
        result.put("fileName", MODEL_FILE);
        result.put("format", "GGUF");
        result.put("quantization", "Q4_0");
        result.put("approximateBytes", EXPECTED_APPROX_BYTES);
        result.put("downloadUrl", MODEL_URL);
        result.put("installed", modelFile().isFile() && modelFile().length() > 0);
        result.put("downloadInProgress", downloading);
        result.put("downloadState", downloadState);
        result.put("downloadMessage", downloadMessage);
        result.put("downloadedBytes", downloadedBytes);
        result.put("runtimeReady", modelLoaded && NATIVE_LIBRARY_LOADED);
        result.put("nativeRuntimeAvailable", NATIVE_LIBRARY_LOADED);
        result.put("loadedInMemory", modelLoaded);
        result.put("resumableBytes", partialFile().isFile() ? partialFile().length() : 0);
        call.resolve(result);
    }

    @PluginMethod
    public void startModelDownload(PluginCall call) {
        if (downloading) {
            call.reject("Já existe um download em andamento.");
            return;
        }
        if (modelFile().isFile() && modelFile().length() > 0) {
            JSObject result = new JSObject();
            result.put("started", false);
            result.put("alreadyInstalled", true);
            call.resolve(result);
            return;
        }

        long freeSpace = modelDirectory().getFreeSpace();
        if (freeSpace < EXPECTED_APPROX_BYTES + 64L * 1024L * 1024L) {
            call.reject("Espaço insuficiente. Libere pelo menos 500 MB antes de baixar o modelo.");
            return;
        }
        cancelDownload.set(false);
        downloading = true;
        downloadState = "downloading";
        downloadMessage = "Conectando ao servidor do modelo…";
        downloadedBytes = partialFile().isFile() ? partialFile().length() : 0L;
        JSObject accepted = new JSObject();
        accepted.put("started", true);
        accepted.put("resuming", partialFile().isFile() && partialFile().length() > 0);
        call.resolve(accepted);

        executor.execute(this::downloadModel);
    }

    private void downloadModel() {
        HttpURLConnection connection = null;
        try {
            File part = partialFile();
            long offset = part.isFile() ? part.length() : 0L;
            URL url = new URL(MODEL_URL);
            connection = (HttpURLConnection) url.openConnection();
            connection.setConnectTimeout(20000);
            connection.setReadTimeout(30000);
            connection.setInstanceFollowRedirects(true);
            connection.setRequestProperty("User-Agent", "ORBIA-Android/1.0");
            if (offset > 0) connection.setRequestProperty("Range", "bytes=" + offset + "-");

            int code = connection.getResponseCode();
            if (offset > 0 && code == HttpURLConnection.HTTP_OK) {
                // O servidor ignorou Range: reinicia o arquivo para não corromper o GGUF.
                offset = 0;
            } else if (offset > 0 && code != 206) {
                throw new Exception("O servidor não aceitou a retomada (HTTP " + code + ").");
            } else if (offset == 0 && code != HttpURLConnection.HTTP_OK) {
                throw new Exception("Falha no servidor de download (HTTP " + code + ").");
            }

            long responseLength = connection.getContentLengthLong();
            long total = responseLength > 0 ? responseLength + offset : -1L;
            try (InputStream input = connection.getInputStream();
                 FileOutputStream output = new FileOutputStream(part, offset > 0)) {
                byte[] buffer = new byte[64 * 1024];
                long downloaded = offset;
                int read;
                long lastEvent = 0;
                while ((read = input.read(buffer)) != -1) {
                    if (cancelDownload.get()) {
                        emitDownloadState("cancelled", downloaded, total, "Download pausado. Você pode continuar depois.");
                        return;
                    }
                    output.write(buffer, 0, read);
                    downloaded += read;
                    downloadedBytes = downloaded;
                    long now = System.currentTimeMillis();
                    if (now - lastEvent >= 500) {
                        emitProgress(downloaded, total);
                        lastEvent = now;
                    }
                }
                output.getFD().sync();
                emitProgress(downloaded, total);
            }

            if (cancelDownload.get()) {
                downloadState = "cancelled";
                downloadMessage = "Download pausado.";
                emitDownloadState("cancelled", part.length(), total, downloadMessage);
                return;
            }

            downloadState = "verifying";
            downloadMessage = "Download concluído. Verificando a integridade do modelo…";
            emitDownloadState("verifying", part.length(), total, downloadMessage);

            if (part.length() < 100L * 1024L * 1024L || !hasGgufMagic(part)) {
                throw new Exception("O arquivo recebido não parece ser um modelo GGUF válido.");
            }
            if (!EXPECTED_SHA256.equals(sha256(part))) {
                part.delete();
                throw new Exception("A verificação SHA-256 do modelo falhou. O download foi descartado por segurança; tente novamente.");
            }

            downloadState = "installing";
            downloadMessage = "Verificação concluída. Salvando o modelo no aparelho…";
            emitDownloadState("installing", part.length(), total, downloadMessage);

            File destination = modelFile();
            if (destination.exists() && !destination.delete()) {
                throw new Exception("Não foi possível substituir o modelo anterior.");
            }
            if (!part.renameTo(destination)) {
                copyFile(part, destination);
                if (!part.delete()) part.deleteOnExit();
            }
            downloadedBytes = destination.length();
            downloadState = "completed";
            downloadMessage = "Modelo baixado, verificado e salvo no armazenamento privado do ORBIA.";
            downloading = false;
            emitDownloadState("completed", destination.length(), total, downloadMessage);
        } catch (Exception error) {
            downloadState = "error";
            downloadMessage = error.getMessage() == null ? "Falha no download do modelo." : error.getMessage();
            downloadedBytes = partialFile().isFile() ? partialFile().length() : 0L;
            downloading = false;
            emitDownloadState("error", downloadedBytes, -1L, downloadMessage);
        } finally {
            if (connection != null) connection.disconnect();
            downloading = false;
            if ("downloading".equals(downloadState) || "verifying".equals(downloadState) || "installing".equals(downloadState)) {
                downloadState = "error";
                downloadMessage = "O download foi encerrado inesperadamente. Você pode tentar novamente.";
            }
        }
    }

    private String sha256(File file) throws Exception {
        MessageDigest digest = MessageDigest.getInstance("SHA-256");
        try (InputStream input = new FileInputStream(file)) {
            byte[] buffer = new byte[128 * 1024];
            int count;
            while ((count = input.read(buffer)) != -1) digest.update(buffer, 0, count);
        }
        StringBuilder hex = new StringBuilder();
        for (byte value : digest.digest()) hex.append(String.format("%02x", value & 0xff));
        return hex.toString();
    }

    private boolean hasGgufMagic(File file) {
        try (FileInputStream input = new FileInputStream(file)) {
            return input.read() == 'G' && input.read() == 'G' &&
                   input.read() == 'U' && input.read() == 'F';
        } catch (Exception ignored) {
            return false;
        }
    }

    private void copyFile(File source, File destination) throws Exception {
        try (InputStream input = new FileInputStream(source);
             FileOutputStream output = new FileOutputStream(destination)) {
            byte[] buffer = new byte[64 * 1024];
            int count;
            while ((count = input.read(buffer)) != -1) output.write(buffer, 0, count);
            output.getFD().sync();
        }
    }

    private void emitProgress(long downloaded, long total) {
        JSObject event = new JSObject();
        downloadedBytes = downloaded;
        downloadState = "downloading";
        downloadMessage = "Baixando o modelo…";
        event.put("state", "downloading");
        event.put("downloadedBytes", downloaded);
        event.put("totalBytes", total);
        event.put("progress", total > 0 ? Math.min(100, (downloaded * 100.0) / total) : -1);
        new Handler(Looper.getMainLooper()).post(() -> notifyListeners("modelDownloadProgress", event));
    }

    private void emitDownloadState(String state, long downloaded, long total, String message) {
        downloadState = state;
        downloadMessage = message;
        downloadedBytes = downloaded;
        JSObject event = new JSObject();
        event.put("state", state);
        event.put("downloadedBytes", downloaded);
        event.put("totalBytes", total);
        event.put("progress", total > 0 ? Math.min(100, (downloaded * 100.0) / total) : -1);
        event.put("message", message);
        new Handler(Looper.getMainLooper()).post(() -> notifyListeners("modelDownloadState", event));
    }

    @PluginMethod
    public void cancelModelDownload(PluginCall call) {
        cancelDownload.set(true);
        JSObject result = new JSObject();
        result.put("cancellationRequested", true);
        call.resolve(result);
    }

    @PluginMethod
    public void deleteModel(PluginCall call) {
        if (downloading || modelLoaded || generationInProgress || modelLoading) {
            call.reject("Descarregue o modelo e aguarde o fim da geração antes de remover o arquivo.");
            return;
        }
        boolean removed = !modelFile().exists() || modelFile().delete();
        boolean partialRemoved = !partialFile().exists() || partialFile().delete();
        if (!removed || !partialRemoved) {
            call.reject("Não foi possível remover todos os arquivos do modelo.");
            return;
        }
        JSObject result = new JSObject();
        result.put("deleted", true);
        call.resolve(result);
    }

    @PluginMethod
    public void loadModel(PluginCall call) {
        if (!NATIVE_LIBRARY_LOADED) {
            call.reject("Runtime llama.cpp não está disponível neste APK.");
            return;
        }
        if (modelLoaded) {
            JSObject ready = new JSObject();
            ready.put("loaded", true);
            ready.put("alreadyLoaded", true);
            call.resolve(ready);
            return;
        }
        if (modelLoading || downloading) {
            call.reject("Aguarde o download ou carregamento atual terminar.");
            return;
        }
        if (!modelFile().isFile() || modelFile().length() == 0) {
            call.reject("Baixe o modelo antes de carregá-lo.");
            return;
        }
        modelLoading = true;
        int contextSize = Math.max(512, Math.min(2048, call.getInt("contextSize", 1024)));
        int threads = Math.max(2, Math.min(4, call.getInt("threads", 3)));
        executor.execute(() -> {
            String error;
            try { error = nativeLoadModel(modelFile().getAbsolutePath(), contextSize, threads); }
            catch (Throwable failure) { error = failure.getMessage(); }
            final String message = error;
            mainHandler.post(() -> {
                modelLoading = false;
                modelLoaded = message == null;
                if (modelLoaded) {
                    JSObject ready = new JSObject();
                    ready.put("loaded", true);
                    ready.put("contextSize", contextSize);
                    ready.put("threads", threads);
                    call.resolve(ready);
                } else {
                    call.reject(message == null ? "Não foi possível carregar o modelo." : message);
                }
            });
        });
    }

    @PluginMethod
    public void unloadModel(PluginCall call) {
        if (generationInProgress || modelLoading) {
            call.reject("Aguarde a geração ou o carregamento terminar.");
            return;
        }
        executor.execute(() -> {
            try { if (NATIVE_LIBRARY_LOADED) nativeUnloadModel(); }
            catch (Throwable ignored) {}
            modelLoaded = false;
            mainHandler.post(() -> {
                JSObject result = new JSObject();
                result.put("unloaded", true);
                call.resolve(result);
            });
        });
    }

    @PluginMethod
    public void generate(PluginCall call) {
        if (!modelLoaded) {
            call.reject("Carregue o modelo local antes de conversar.");
            return;
        }
        if (generationInProgress) {
            call.reject("Já existe uma resposta sendo gerada.");
            return;
        }
        String prompt = call.getString("prompt", "").trim();
        if (prompt.isEmpty()) {
            call.reject("Digite uma mensagem.");
            return;
        }
        int maxTokens = Math.max(16, Math.min(256, call.getInt("maxTokens", 192)));
        float temperature = (float) Math.max(0.1, Math.min(1.2, call.getDouble("temperature", 0.7)));
        generationInProgress = true;
        executor.execute(() -> {
            String answer;
            try {
                answer = nativeGenerate(prompt, maxTokens, temperature, token -> {
                    JSObject event = new JSObject();
                    event.put("token", token);
                    mainHandler.post(() -> notifyListeners("generationToken", event));
                });
            } catch (Throwable failure) {
                answer = null;
            }
            final String resultText = answer;
            mainHandler.post(() -> {
                generationInProgress = false;
                if (resultText == null) {
                    call.reject("A geração local falhou. Tente descarregar e carregar o modelo novamente.");
                } else {
                    JSObject result = new JSObject();
                    result.put("text", resultText);
                    call.resolve(result);
                    JSObject state = new JSObject();
                    state.put("state", "completed");
                    notifyListeners("generationState", state);
                }
            });
        });
    }

    @PluginMethod
    public void stopGeneration(PluginCall call) {
        if (NATIVE_LIBRARY_LOADED) nativeStopGeneration();
        JSObject result = new JSObject();
        result.put("stopRequested", true);
        call.resolve(result);
    }
}
